# GEMINI_API_KEY: Required for Gemini AI API calls.
# Without it, AI endpoints automatically fall back to deterministic rule-based heuristics.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"

# NODE_ENV: "development" or "production"
NODE_ENV="development"

# Optional API rate limiting configuration (defaults: 30 requests per 60000ms per IP)
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="30"

# Optional Microsoft Clarity Project ID for opt-in consent-based analytics
# Analytics stay disabled unless VITE_CLARITY_ID is set AND the user explicitly opts in.
VITE_CLARITY_ID=""

