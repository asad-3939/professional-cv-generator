rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users cannot scrape all user accounts
      allow create, update: if isOwner(userId);
      allow delete: if false;

      // User CVs subcollection
      match /cvs/{cvId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      // User Export History subcollection
      match /history/{historyId} {
        allow get, list, create, delete: if isOwner(userId);
        allow update: if false; // Export history records are immutable snapshots
      }
    }
  }
}

